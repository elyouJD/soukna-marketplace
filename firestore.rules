rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only this Firebase Authentication UID is allowed to administer the marketplace.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in ['odDrCkEPJoaRYYzAYsc52DBU4hf1'];
    }

    function validAd(data) {
      return data.keys().hasAll([
          'title','description','price','currency','category','location',
          'whatsapp','images','status','createdAt','updatedAt'
        ])
        && data.keys().hasOnly([
          'title','description','price','currency','category','location',
          'whatsapp','images','status','createdAt','updatedAt'
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 90
        && data.description is string && data.description.size() > 0 && data.description.size() <= 1200
        && data.price is number && data.price >= 0 && data.price <= 100000000
        && data.currency in ['EUR', 'MAD']
        && data.category in ['electronics','home','fashion','vehicles','sports','other']
        && data.location is string && data.location.size() > 0 && data.location.size() <= 70
        && data.whatsapp is string && data.whatsapp.size() >= 8 && data.whatsapp.size() <= 25
        && data.images is list && data.images.size() <= 5
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    match /ads/{adId} {
      // Visitors can only read approved listings. Admin can see pending and paused listings too.
      allow read: if isAdmin() || resource.data.status == 'active';

      // Anyone can submit a listing without creating an account. Every new listing is pending.
      allow create: if request.resource.data.status == 'pending'
        && validAd(request.resource.data);

      // Only the administrator can approve, edit, pause or delete listings.
      allow update, delete: if isAdmin();
    }

    match /reports/{reportId} {
      // Visitors may report an ad without logging in.
      allow create: if request.resource.data.keys().hasOnly(['adId','reason','createdAt','reporterUid','status'])
        && request.resource.data.adId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500;
      allow read, update, delete: if isAdmin();
    }

    // No public user accounts exist in this version. User administration is private.
    match /users/{uid} {
      allow read, write: if isAdmin();
    }
  }
}
